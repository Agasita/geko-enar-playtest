  "ctx": "ステージ 11-1 ヒント",
  "id": "T0284"
 },
 "T0285": {
  "file": "v2/levels.js",
  "line": 640,
  "q": "'",
  "text": "ひとつめは「よせ→」で ブロックを はんていセル（むらさき）へ",
