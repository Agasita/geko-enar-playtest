  "ctx": "ステージ 11-1 ヒント",
  "id": "T0285"
 },
 "T0286": {
  "file": "v2/levels.js",
  "line": 641,
  "q": "'",
  "text": "ふたつめの はんていセルは みどりを ほしがっている。ガラスに いろコピー して、よせよう",
