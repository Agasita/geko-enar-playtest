  "ctx": "ステージ 10-3 ヒント",
  "id": "T0279"
 },
 "T0280": {
  "file": "v2/levels.js",
  "line": 619,
  "q": "'",
  "text": "ブロックで リフトを うごかす",
  "k": 0,
  "ctx": "ステージ 10-4 なまえ",
  "id": "T0280"
 },
 "T0281": {
  "file": "v2/levels.js",
  "line": 621,
  "q": "'",
  "text": "この リフトは とまっている。はんていセル「1」が ONの あいだだけ うごく（おなじ いろ・おなじ 番号が つながっている）",
