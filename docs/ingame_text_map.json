  "ctx": "ステージ 10-3 ヒント",
  "id": "T0278"
 },
 "T0279": {
  "file": "v2/levels.js",
  "line": 606,
  "q": "'",
  "text": "ガラスに「いろコピー」で みどりを うつして、「よせ→」で はんていセルへ",
