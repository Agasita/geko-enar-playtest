  "ctx": "ステージ 10-1 ヒント",
  "id": "T0273"
 },
 "T0274": {
  "file": "v2/levels.js",
  "line": 587,
  "q": "'",
  "text": "あきセルと そんざいセル",
  "k": 0,
  "ctx": "ステージ 10-2 なまえ",
  "id": "T0274"
 },
 "T0275": {
  "file": "v2/levels.js",
  "line": 589,
  "q": "'",
  "text": "ふたつの はんていセルが ぜんぶ ONで、とびらが ひらく。むらさき=ブロックが ある、はいいろ=なにも ない",
