  "ctx": "ステージ 10-2 ヒント",
  "id": "T0275"
 },
 "T0276": {
  "file": "v2/levels.js",
  "line": 590,
  "q": "'",
  "text": "ブロックを みぎへ よせると ちゃいろが「□」の マスに ひっかかる。フィルターで うすくすれば「ない」になる",
  "k": 0,
  "ctx": "ステージ 10-2 ヒント",
  "id": "T0276"
 },
 "T0277": {
  "file": "v2/levels.js",
  "line": 603,
  "q": "'",
  "text": "いろセル",
  "k": 0,
  "ctx": "ステージ 10-3 なまえ",
  "id": "T0277"
 },
 "T0278": {
  "file": "v2/levels.js",
  "line": 605,
  "q": "'",
  "text": "この はんていセルは「みどり」の ブロックを ほしがっている",
