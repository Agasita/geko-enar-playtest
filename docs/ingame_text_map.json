  "ctx": "ステージ LAB ヒント",
  "id": "T0296"
 },
 "T0297": {
  "file": "v2/levels.js",
  "line": 710,
  "q": "'",
  "text": "いろのちがうブロックのれつ（ガラスもある）。「ならべかえ」「いろコピー（ガラスだけ）」をためそう",
  "k": 0,
  "ctx": "ステージ LAB ヒント",
  "id": "T0297"
 },
 "T0298": {
  "file": "v2/levels.js",
  "line": 711,
  "q": "'",
  "text": "カギはまもり。「まもりをはずす」ではずしてから、よせる・かたちができる",
  "k": 0,
  "ctx": "ステージ LAB ヒント",
  "id": "T0298"
 },
 "T0299": {
  "file": "v2/levels.js",
  "line": 712,
  "q": "'",
  "text": "あなは、ジャンプ＋ふわりでこえよう",
  "k": 0,
  "ctx": "ステージ LAB ヒント",
  "id": "T0299"
 },
 "T0300": {
  "file": "v2/levels.js",
  "line": 713,
