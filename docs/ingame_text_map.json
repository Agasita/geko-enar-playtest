  "ctx": "ステージ 10-4 ヒント",
  "id": "T0281"
 },
 "T0282": {
  "file": "v2/levels.js",
  "line": 622,
  "q": "'",
  "text": "「よせ→」で ブロックを はんていセルに のせよう。じぶんが たっても ONになるけど、のると うごかない…",
